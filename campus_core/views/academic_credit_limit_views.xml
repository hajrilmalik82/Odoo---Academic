<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_academic_credit_limit_tree" model="ir.ui.view">
        <field name="name">academic.credit.limit.list</field>
        <field name="model">academic.credit.limit</field>
        <field name="arch" type="xml">
            <list string="Credit Limits" editable="bottom">
                <field name="min_cgpa"/>
                <field name="max_credits"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_academic_credit_limit_form" model="ir.ui.view">
        <field name="name">academic.credit.limit.form</field>
        <field name="model">academic.credit.limit</field>
        <field name="arch" type="xml">
            <form string="Credit Limit">
                <sheet>
                    <group>
                        <field name="min_cgpa"/>
                        <field name="max_credits"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_academic_credit_limit" model="ir.actions.act_window">
        <field name="name">Credit Limits</field>
        <field name="res_model">academic.credit.limit</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define how many credits a student may take at each CGPA level
            </p>
            <p>
                Bands are read from the highest CGPA down, and the first one the
                student reaches applies. Keep a band at 0.00 so students with no
                grades yet still have a limit.
            </p>
        </field>
    </record>

    <menuitem id="menu_academic_credit_limit"
              name="Credit Limits"
              parent="menu_academic_configuration"
              action="action_academic_credit_limit"
              sequence="45"/>
</odoo>
