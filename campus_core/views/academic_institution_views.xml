<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Faculty Views -->
    <record id="view_academic_faculty_tree" model="ir.ui.view">
        <field name="name">academic.faculty.tree</field>
        <field name="model">academic.faculty</field>
        <field name="arch" type="xml">
            <list string="Faculties">
                <field name="code"/>
                <field name="name"/>
                <field name="company_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_academic_faculty_form" model="ir.ui.view">
        <field name="name">academic.faculty.form</field>
        <field name="model">academic.faculty</field>
        <field name="arch" type="xml">
            <form string="Faculty">
                <sheet>
                    <group>
                        <field name="name"/>
                        <!-- Builds the NIM prefix; locked once a student number
                             has been issued from it. -->
                        <field name="code" placeholder="e.g. FT"/>
                        <field name="dean_id"/>
                        <field name="department_id" options="{'no_create': True}"/>
                        <field name="company_id" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Program Views -->
    <record id="view_academic_program_tree" model="ir.ui.view">
        <field name="name">academic.program.tree</field>
        <field name="model">academic.program</field>
        <field name="arch" type="xml">
            <list string="Programs">
                <field name="code"/>
                <field name="name"/>
                <field name="faculty_id"/>
                <field name="company_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_academic_program_form" model="ir.ui.view">
        <field name="name">academic.program.form</field>
        <field name="model">academic.program</field>
        <field name="arch" type="xml">
            <form string="Program">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code" placeholder="e.g. TI"/>
                        <field name="faculty_id"/>
                        <field name="head_id"/>
                        <field name="department_id" options="{'no_create': True}"/>
                        <field name="company_id" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Subject Views -->
    <record id="view_academic_subject_tree" model="ir.ui.view">
        <field name="name">academic.subject.tree</field>
        <field name="model">academic.subject</field>
        <field name="arch" type="xml">
            <list string="Subjects">
                <field name="code"/>
                <field name="name"/>
                <field name="credits"/>
                <field name="semester"/>
                <field name="term_type"/>
                <field name="program_id"/>
                <field name="company_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_academic_subject_form" model="ir.ui.view">
        <field name="name">academic.subject.form</field>
        <field name="model">academic.subject</field>
        <field name="arch" type="xml">
            <form string="Subject">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="credits"/>
                        </group>
                        <group>
                            <field name="semester"/>
                            <field name="term_type"/>
                            <field name="program_id"/>
                            <field name="prerequisite_ids" widget="many2many_tags"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_academic_subject_search" model="ir.ui.view">
        <field name="name">academic.subject.search</field>
        <field name="model">academic.subject</field>
        <field name="arch" type="xml">
            <search string="Search Subjects">
                <field name="name"/>
                <field name="code"/>
                <field name="program_id"/>
                <field name="faculty_id"/>
                <searchpanel>
                    <field name="program_id" icon="fa-building" enable_counters="1" groupby="faculty_id" select="multi"/>
                    <field name="semester" icon="fa-list" enable_counters="1" select="multi"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <!-- Academic Year Views -->
    <record id="view_academic_year_tree" model="ir.ui.view">
        <field name="name">academic.year.tree</field>
        <field name="model">academic.year</field>
        <field name="arch" type="xml">
            <list string="Academic Years" decoration-muted="not active">
                <field name="name"/>
                <field name="term_type"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="krs_start_date"/>
                <field name="krs_end_date"/>
                <field name="company_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_academic_year_form" model="ir.ui.view">
        <field name="name">academic.year.form</field>
        <field name="model">academic.year</field>
        <field name="arch" type="xml">
            <form string="Academic Year">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="term_type"/>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="krs_start_date"/>
                            <field name="krs_end_date"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_academic_faculty" model="ir.actions.act_window">
        <field name="name">Faculties</field>
        <field name="res_model">academic.faculty</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_academic_program" model="ir.actions.act_window">
        <field name="name">Programs</field>
        <field name="res_model">academic.program</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_academic_subject" model="ir.actions.act_window">
        <field name="name">Subjects</field>
        <field name="res_model">academic.subject</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_academic_year" model="ir.actions.act_window">
        <field name="name">Academic Years</field>
        <field name="res_model">academic.year</field>
        <field name="view_mode">list,form</field>
        <!-- Archived years stay on the list instead of hiding behind the Archived
             filter. There are only a handful of them, they are consulted often
             when checking an old intake, and the list already carries an Active
             column to tell them apart. Archiving still does its real job
             elsewhere: an archived year is kept out of every dropdown, which is
             what stops anyone registering a KRS against a closed term. -->
        <field name="context">{'active_test': False}</field>
    </record>

</odoo>
