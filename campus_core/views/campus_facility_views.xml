<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Campus Building Views -->
    <!-- Search views. Without one Odoo falls back to a one-field auto view,
         which leaves no way to filter rooms by building or by type on a campus
         with more than a handful of them. -->
    <record id="view_campus_building_search" model="ir.ui.view">
        <field name="name">campus.building.search</field>
        <field name="model">campus.building</field>
        <field name="arch" type="xml">
            <search string="Search Buildings">
                <field name="name"/>
                <field name="code"/>
                <field name="location"/>
            </search>
        </field>
    </record>

    <record id="view_campus_room_search" model="ir.ui.view">
        <field name="name">campus.room.search</field>
        <field name="model">campus.room</field>
        <field name="arch" type="xml">
            <search string="Search Rooms">
                <field name="name"/>
                <field name="building_id"/>
                <field name="room_type"/>
                <group>
                    <filter name="group_building" string="Building" domain="[]" context="{'group_by': 'building_id'}"/>
                    <filter name="group_type" string="Room Type" domain="[]" context="{'group_by': 'room_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_campus_building_tree" model="ir.ui.view">
        <field name="name">campus.building.tree</field>
        <field name="model">campus.building</field>
        <field name="arch" type="xml">
            <list string="Buildings">
                <field name="name"/>
                <field name="code"/>
                <field name="location"/>
                <field name="company_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_campus_building_form" model="ir.ui.view">
        <field name="name">campus.building.form</field>
        <field name="model">campus.building</field>
        <field name="arch" type="xml">
            <form string="Building">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="location"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Campus Room Views -->
    <record id="view_campus_room_tree" model="ir.ui.view">
        <field name="name">campus.room.tree</field>
        <field name="model">campus.room</field>
        <field name="arch" type="xml">
            <list string="Rooms">
                <field name="name"/>
                <field name="building_id"/>
                <field name="capacity"/>
                <field name="room_type"/>
                <field name="company_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_campus_room_form" model="ir.ui.view">
        <field name="name">campus.room.form</field>
        <field name="model">campus.room</field>
        <field name="arch" type="xml">
            <form string="Room">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="building_id"/>
                        </group>
                        <group>
                            <field name="capacity"/>
                            <field name="room_type"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_campus_building" model="ir.actions.act_window">
        <field name="name">Buildings</field>
        <field name="res_model">campus.building</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_campus_room" model="ir.actions.act_window">
        <field name="name">Rooms</field>
        <field name="res_model">campus.room</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
