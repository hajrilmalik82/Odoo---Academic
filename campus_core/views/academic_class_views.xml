<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Class Views -->
    <record id="view_academic_class_tree" model="ir.ui.view">
        <field name="name">academic.class.tree</field>
        <field name="model">academic.class</field>
        <field name="arch" type="xml">
            <list string="Classes">
                <field name="name"/>
                <field name="subject_id"/>
                <field name="academic_year_id"/>
                <field name="start_date"/>
                <field name="class_capacity_display"/>
                <field name="company_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_academic_class_form" model="ir.ui.view">
        <field name="name">academic.class.form</field>
        <field name="model">academic.class</field>
        <field name="arch" type="xml">
            <form string="Class">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Class Name (e.g. ALPRO - A)"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="subject_id"/>
                            <field name="academic_year_id"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Weekly Schedule">
                            <group>
                                <field name="class_capacity_display" readonly="1" class="fw-bold"/>
                            </group>
                            <field name="schedule_ids">
                                <list editable="bottom">
                                    <field name="class_code"/>
                                    <field name="day_of_week"/>
                                    <field name="start_time" widget="float_time"/>
                                    <field name="end_time" widget="float_time"/>
                                    <field name="room_id"/>
                                    <field name="capacity_display"/>
                                    <!-- Needed by the client-side domain on
                                         lecturer_id that campus_employees applies. -->
                                    <field name="class_program_id" column_invisible="1"/>
                                    <field name="class_faculty_id" column_invisible="1"/>
                                    <field name="lecturer_id"/>
                                    <field name="company_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Students">
                            <div class="mb-2">
                                <button name="%(action_assign_schedule_wizard)d" string="Assign Schedule (Massive)" type="action" class="oe_highlight" icon="fa-magic"/>
                            </div>
                            <field name="student_line_ids">
                                <list editable="bottom" create="0" delete="0">
                                    <field name="class_id" column_invisible="1"/>
                                    <field name="student_id" readonly="1"/>
                                    <field name="schedule_id" readonly="1"/>
                                    <field name="state" widget="badge" decoration-info="state == 'submitted'" decoration-success="state in ('approved', 'locked')" decoration-warning="state == 'revision'" decoration-muted="state == 'draft'" decoration-danger="state == 'rejected'" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Real Sessions">
                            <div class="mb-2">
                                <button name="action_generate_sessions" string="Generate Sessions" type="object" class="oe_highlight"/>
                            </div>
                            <field name="session_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="start_datetime"/>
                                    <field name="end_datetime"/>
                                    <field name="room_id"/>
                                    <field name="lecturer_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Session Views -->
    <!-- Sessions is the one list here whose row count is unbounded: every class
         generates a session per week per schedule, so it grows all term. With no
         search view Odoo fell back to a one-field auto view, which left no way to
         find a room's bookings or a lecturer's week. -->
    <record id="view_academic_class_session_search" model="ir.ui.view">
        <field name="name">academic.class.session.search</field>
        <field name="model">academic.class.session</field>
        <field name="arch" type="xml">
            <search string="Search Sessions">
                <field name="name"/>
                <field name="class_id"/>
                <field name="lecturer_id"/>
                <field name="room_id"/>
                <filter name="upcoming" string="Upcoming" domain="[('start_datetime', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="this_week" string="This Week" domain="[('start_datetime', '&gt;=', (context_today() - relativedelta(days=context_today().weekday())).strftime('%Y-%m-%d')), ('start_datetime', '&lt;', (context_today() + relativedelta(days=7 - context_today().weekday())).strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter name="group_class" string="Class" domain="[]" context="{'group_by': 'class_id'}"/>
                    <filter name="group_lecturer" string="Lecturer" domain="[]" context="{'group_by': 'lecturer_id'}"/>
                    <filter name="group_room" string="Room" domain="[]" context="{'group_by': 'room_id'}"/>
                    <filter name="group_start" string="Date" domain="[]" context="{'group_by': 'start_datetime:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_academic_class_session_tree" model="ir.ui.view">
        <field name="name">academic.class.session.tree</field>
        <field name="model">academic.class.session</field>
        <field name="arch" type="xml">
            <list string="Sessions">
                <field name="name"/>
                <field name="class_id"/>
                <field name="start_datetime"/>
                <field name="end_datetime"/>
                <field name="room_id"/>
                <field name="lecturer_id"/>
            </list>
        </field>
    </record>

    <record id="view_academic_class_session_form" model="ir.ui.view">
        <field name="name">academic.class.session.form</field>
        <field name="model">academic.class.session</field>
        <field name="arch" type="xml">
            <form string="Session">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="class_id"/>
                        </group>
                        <group>
                            <field name="start_datetime"/>
                            <field name="end_datetime"/>
                            <field name="room_id"/>
                            <!-- Needed by the client-side domain on lecturer_id
                                 that campus_employees applies. Without them the
                                 domain cannot be evaluated and the picker falls
                                 back to offering every employee. -->
                            <field name="class_program_id" invisible="1"/>
                            <field name="class_faculty_id" invisible="1"/>
                            <field name="lecturer_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Calendar view for Session -->
    <record id="view_academic_class_session_calendar" model="ir.ui.view">
        <field name="name">academic.class.session.calendar</field>
        <field name="model">academic.class.session</field>
        <field name="arch" type="xml">
            <calendar string="Class Sessions" date_start="start_datetime" date_stop="end_datetime" color="class_id">
                <field name="name"/>
                <field name="room_id"/>
                <field name="lecturer_id"/>
            </calendar>
        </field>
    </record>

    <record id="action_academic_class" model="ir.actions.act_window">
        <field name="name">Classes</field>
        <field name="res_model">academic.class</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_academic_class_session" model="ir.actions.act_window">
        <field name="name">Sessions</field>
        <field name="res_model">academic.class.session</field>
        <field name="view_mode">calendar,list,form</field>
    </record>

</odoo>
