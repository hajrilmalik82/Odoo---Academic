<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_transcript_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page" style="font-family: 'Times New Roman', Times, serif;">

                        <!-- DOCUMENT TITLE -->
                        <div class="text-center mb-4">
                            <h3 style="font-weight: bold; text-transform: uppercase; letter-spacing: 2px; margin-bottom: 2px;">
                                Academic Transcript
                            </h3>
                            <p style="font-size: 10pt; color: #555; margin-bottom: 0;">(Official Academic Record)</p>
                            <hr style="border-top: 2px solid #000; margin-top: 10px;"/>
                        </div>

                        <!-- STUDENT INFORMATION -->
                        <t t-call="campus_core.report_campus_student_header">
                            <t t-set="student" t-value="o.student_id"/>
                            <t t-set="faculty" t-value="o.student_id.faculty_id"/>
                            <t t-set="program" t-value="o.student_id.program_id"/>
                            <tr>
                                <td style="padding: 3px 0;">Generation</td>
                                <td>:</td>
                                <td><t t-out="o.student_id.batch_year or '-'"/></td>
                                <td style="padding: 3px 0;">Status</td>
                                <td>:</td>
                                <td>
                                    <t t-if="o.student_id.student_status == 'active'">Active</t>
                                    <t t-if="o.student_id.student_status == 'leave'">On Leave</t>
                                    <t t-if="o.student_id.student_status == 'graduated'">Graduated</t>
                                    <t t-if="o.student_id.student_status == 'dropout'">Drop Out</t>
                                </td>
                            </tr>
                        </t>

                        <!-- RECOGNISED GRADES, ONE ROW PER SUBJECT.
                             A transcript states what each subject is finally recognised
                             with, not the history of attempts. A repeated subject appears
                             once, carrying the grade that replaced the earlier one; the
                             superseded attempt stays on its own semester's KHS. Both the
                             rows and the totals below come from the same selection on the
                             student record, so the body always adds up to the footer. -->
                        <t t-set="transcript_lines" t-value="o.student_id._recognised_khs_lines()"/>
                        <t t-set="line_no" t-value="0"/>

                        <table class="table table-sm table-bordered" style="font-size: 10pt;">
                            <thead>
                                <tr style="background-color: #2c3e50; color: white; text-align: center;">
                                    <th style="width: 5%; padding: 8px;">No</th>
                                    <th style="width: 15%; padding: 8px;">Semester</th>
                                    <th style="width: 11%; padding: 8px;">Subject Code</th>
                                    <th style="padding: 8px;">Subject Name</th>
                                    <th style="width: 7%; padding: 8px;">Credits</th>
                                    <th style="width: 8%; padding: 8px;">Letter Grade</th>
                                    <th style="width: 8%; padding: 8px;">Weight</th>
                                    <th style="width: 10%; padding: 8px;">Grade Points (Credits×Weight)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="transcript_lines" t-as="line">
                                    <t t-set="line_no" t-value="line_no + 1"/>
                                    <tr>
                                        <td style="text-align: center; padding: 5px;"><t t-out="line_no"/></td>
                                        <td style="text-align: center; padding: 5px;"><t t-out="line.khs_id.academic_year_id.display_name"/></td>
                                        <td style="text-align: center; padding: 5px;"><t t-out="line.subject_id.code or '-'"/></td>
                                        <td style="padding: 5px;"><t t-out="line.subject_id.name"/></td>
                                        <td style="text-align: center; padding: 5px;"><t t-out="line.credits"/></td>
                                        <td style="text-align: center; padding: 5px; font-weight: bold;"><t t-out="line.letter_grade or '-'"/></td>
                                        <td style="text-align: center; padding: 5px;"><t t-out="'%.2f' % line.grade_points"/></td>
                                        <td style="text-align: center; padding: 5px;"><t t-out="'%.2f' % (line.credits * line.grade_points)"/></td>
                                    </tr>
                                </t>
                                <tr t-if="not transcript_lines">
                                    <td colspan="8" style="text-align: center; padding: 10px; font-style: italic; color: #777;">
                                        No graded subjects recorded yet.
                                    </td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr style="background-color: #2c3e50; color: white; font-weight: bold;">
                                    <td colspan="4" style="text-align: right; padding: 10px;">CUMULATIVE TOTAL</td>
                                    <td style="text-align: center; padding: 10px;"><t t-out="o.student_id.graded_credits"/></td>
                                    <td colspan="2" style="text-align: right; padding: 10px;">Cumulative GPA (CGPA)</td>
                                    <td style="text-align: center; padding: 10px; font-size: 12pt;">
                                        <t t-out="'%.2f' % o.student_id.cgpa"/>
                                    </td>
                                </tr>
                                <!-- SKS Lulus, stated separately as an Indonesian
                                     transcript does: credits graded is the CGPA
                                     denominator and includes a failed subject,
                                     credits earned counts only the passes. -->
                                <!-- Summed from transcript_lines, the selection this page is
                                     already holding, instead of reading
                                     student_id.earned_credits. That field is a non-stored
                                     compute - unlike cgpa and graded_credits beside it - so
                                     reading it walked the student's entire grade history a
                                     second time to produce a number the rows above already
                                     contain. It is not stored because it depends on the
                                     configured passing grade point, which a stored value
                                     would go stale against. -->
                                <t t-set="pass_point" t-value="o.env['res.config.settings'].sudo()._get_pass_grade_point()"/>
                                <t t-set="earned" t-value="sum(line.credits for line in transcript_lines if line.grade_points >= pass_point)"/>
                                <tr style="background-color: #eaf2f8; font-weight: bold;">
                                    <td colspan="4" style="text-align: right; padding: 8px;">CREDITS EARNED (SKS LULUS)</td>
                                    <td style="text-align: center; padding: 8px;"><t t-out="earned"/></td>
                                    <td colspan="3" style="padding: 8px;"/>
                                </tr>
                            </tfoot>
                        </table>

                        <p style="margin-top: 6px; font-size: 8.5pt; font-style: italic; color: #555;">
                            Each subject is listed once with its recognised grade. For a repeated
                            subject, the recognised grade replaces the earlier attempt and only
                            that grade counts towards the total credits and the CGPA.
                        </p>

                        <!-- GRADING SCALE -->
                        <div style="margin-top: 15px; font-size: 9pt; page-break-inside: avoid;">
                            <p style="font-weight: bold; margin-bottom: 5px;">Grading Scale:</p>
                            <table style="width: 60%; border-collapse: collapse;">
                                <tr style="background-color: #f5f5f5;">
                                    <th style="border: 1px solid #ccc; padding: 4px; text-align: center;">Numeric Grade</th>
                                    <th style="border: 1px solid #ccc; padding: 4px; text-align: center;">Letter</th>
                                    <th style="border: 1px solid #ccc; padding: 4px; text-align: center;">Weight</th>
                                    <th style="border: 1px solid #ccc; padding: 4px; text-align: center;">Description</th>
                                </tr>
                                <!-- Read from academic.grade.scale, not written out here.
                                     These nine rows used to be literals, so a registrar
                                     editing Configuration > Grade Scale produced a
                                     transcript whose letter grades followed the new bands
                                     while this legend still stated the old cut-offs.
                                     sudo() because a student prints their own transcript
                                     from the portal and holds no rights on the scale. -->
                                <tr t-foreach="o.env['academic.grade.scale'].sudo()._get_scale_rows()" t-as="band">
                                    <td style="border: 1px solid #ccc; padding: 4px; text-align: center;"><t t-out="band['range']"/></td>
                                    <td style="border: 1px solid #ccc; padding: 4px; text-align: center;"><t t-out="band['letter']"/></td>
                                    <td style="border: 1px solid #ccc; padding: 4px; text-align: center;"><t t-out="band['grade_point']"/></td>
                                    <td style="border: 1px solid #ccc; padding: 4px;"><t t-out="band['description']"/></td>
                                </tr>
                            </table>
                        </div>

                        <!-- SIGNATURES -->
                        <t t-call="campus_core.report_campus_signatures">
                            <t t-set="faculty" t-value="o.student_id.faculty_id"/>
                            <t t-set="program" t-value="o.student_id.program_id"/>
                        </t>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
