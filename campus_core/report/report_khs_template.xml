<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_khs_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page" style="font-family: 'Times New Roman', Times, serif;">

                        <!-- DOCUMENT TITLE -->
                        <div class="text-center mb-4">
                            <h3 style="font-weight: bold; text-transform: uppercase; letter-spacing: 2px; margin-bottom: 2px;">
                                Study Result Card (KHS)
                            </h3>
                            <p style="font-size: 11pt; color: #555; margin-bottom: 0;">
                                Semester: <strong><t t-out="o.academic_year_id.name or '-'"/></strong>
                            </p>
                            <hr style="border-top: 2px solid #000; margin-top: 10px;"/>
                        </div>

                        <!-- STUDENT INFORMATION -->
                        <t t-call="campus_core.report_campus_student_header">
                            <t t-set="student" t-value="o.student_id"/>
                            <t t-set="faculty" t-value="o.student_id.faculty_id"/>
                            <t t-set="program" t-value="o.student_id.program_id"/>
                            <tr>
                                <td style="padding: 3px 0;">Academic Year</td>
                                <td>:</td>
                                <td><t t-out="o.academic_year_id.display_name or '-'"/></td>
                                <td style="padding: 3px 0;">KHS No.</td>
                                <td>:</td>
                                <td><t t-out="o.name"/></td>
                            </tr>
                        </t>

                        <!-- GRADES TABLE -->
                        <table class="table table-sm table-bordered" style="font-size: 10pt;">
                            <thead>
                                <tr style="background-color: #2c3e50; color: white; text-align: center;">
                                    <th style="width: 5%; padding: 8px;">No</th>
                                    <th style="width: 12%; padding: 8px;">Subject Code</th>
                                    <th style="padding: 8px;">Subject Name</th>
                                    <th style="width: 8%; padding: 8px;">Credits</th>
                                    <th style="width: 10%; padding: 8px;">Numeric Grade</th>
                                    <th style="width: 10%; padding: 8px;">Letter Grade</th>
                                    <th style="width: 10%; padding: 8px;">Weight</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="line_no" t-value="0"/>
                                <t t-foreach="o.line_ids" t-as="line">
                                    <t t-set="line_no" t-value="line_no + 1"/>
                                    <tr>
                                        <td style="text-align: center; padding: 6px;"><t t-out="line_no"/></td>
                                        <td style="text-align: center; padding: 6px;"><t t-out="line.subject_id.code or '-'"/></td>
                                        <td style="padding: 6px;"><t t-out="line.subject_id.name"/></td>
                                        <td style="text-align: center; padding: 6px;"><t t-out="line.credits"/></td>
                                        <!-- Keyed off is_graded, not off the value being truthy.
                                             A real mark of 0 is falsy, so the score column printed
                                             "-" while the letter column on the same row printed E
                                             and the weight column printed 0.00 - the row
                                             contradicted itself. is_graded is the field that
                                             actually says whether a lecturer has marked this
                                             subject, and it is what _compute_grade_conversion
                                             keys off too. -->
                                        <td style="text-align: center; padding: 6px;">
                                            <t t-if="line.is_graded" t-out="'%.1f' % line.numeric_grade"/>
                                            <t t-else="">-</t>
                                        </td>
                                        <td style="text-align: center; padding: 6px; font-weight: bold;">
                                            <t t-out="line.letter_grade or '-'"/>
                                        </td>
                                        <td style="text-align: center; padding: 6px;">
                                            <t t-if="line.is_graded" t-out="'%.2f' % line.grade_points"/>
                                            <t t-else="">-</t>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot>
                                <!-- Credits Taken and Credits Graded are stated separately.
                                     The old footer put total_credits next to the Semester GPA, but
                                     the GPA denominator is graded_credits, so while a term was
                                     still being marked the printed figures did not divide into
                                     each other and the reader had no way to see why. -->
                                <tr style="background-color: #ecf0f1; font-weight: bold;">
                                    <td colspan="2" style="text-align: right; padding: 8px;">Credits Taken</td>
                                    <td style="text-align: center; padding: 8px;"><t t-out="o.total_credits"/></td>
                                    <td style="text-align: right; padding: 8px;">Credits Graded</td>
                                    <td style="text-align: center; padding: 8px;"><t t-out="o.graded_credits"/></td>
                                    <td style="text-align: right; padding: 8px;">Semester GPA</td>
                                    <td style="text-align: center; padding: 8px;"><t t-out="'%.2f' % o.term_gpa"/></td>
                                </tr>
                                <tr style="background-color: #d5dbdb; font-weight: bold;">
                                    <td colspan="5"/>
                                    <td style="text-align: right; padding: 8px;">Cumulative GPA (CGPA)</td>
                                    <td style="text-align: center; padding: 8px;"><t t-out="'%.2f' % o.student_id.cgpa"/></td>
                                </tr>
                            </tfoot>
                        </table>

                        <!-- SIGNATURES -->
                        <t t-call="campus_core.report_campus_signatures">
                            <t t-set="faculty" t-value="o.student_id.faculty_id"/>
                            <t t-set="program" t-value="o.student_id.program_id"/>
                        </t>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
