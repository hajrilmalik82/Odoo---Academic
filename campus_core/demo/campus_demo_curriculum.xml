<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The curriculum, with a real prerequisite chain: the semester 3 subjects
         of each programme require the semester 1 subject the student took last
         term. The study plans seeded later rely on that actually working, so
         this is not decoration - if the prerequisite check broke, the demo
         would refuse to load. -->

    <!-- ===================== TEKNIK INFORMATIKA ====================== -->
    <record id="demo_subject_if101" model="academic.subject">
        <field name="name">Algoritma dan Pemrograman</field>
        <field name="code">IF101</field>
        <field name="credits">3</field>
        <field name="semester">1</field>
        <field name="term_type">odd</field>
        <field name="program_id" ref="demo_program_if"/>
    </record>
    <record id="demo_subject_if102" model="academic.subject">
        <field name="name">Matematika Diskrit</field>
        <field name="code">IF102</field>
        <field name="credits">3</field>
        <field name="semester">1</field>
        <field name="term_type">odd</field>
        <field name="program_id" ref="demo_program_if"/>
    </record>
    <record id="demo_subject_if103" model="academic.subject">
        <field name="name">Pengantar Teknologi Informasi</field>
        <field name="code">IF103</field>
        <field name="credits">3</field>
        <field name="semester">1</field>
        <field name="term_type">odd</field>
        <field name="program_id" ref="demo_program_if"/>
    </record>
    <record id="demo_subject_if104" model="academic.subject">
        <field name="name">Bahasa Inggris Teknik</field>
        <field name="code">IF104</field>
        <field name="credits">2</field>
        <field name="semester">1</field>
        <field name="term_type">odd</field>
        <field name="program_id" ref="demo_program_if"/>
    </record>

    <record id="demo_subject_if201" model="academic.subject">
        <field name="name">Struktur Data</field>
        <field name="code">IF201</field>
        <field name="credits">3</field>
        <field name="semester">3</field>
        <field name="term_type">odd</field>
        <field name="program_id" ref="demo_program_if"/>
        <field name="prerequisite_ids" eval="[(6, 0, [ref('demo_subject_if101')])]"/>
    </record>
    <record id="demo_subject_if202" model="academic.subject">
        <field name="name">Basis Data</field>
        <field name="code">IF202</field>
        <field name="credits">3</field>
        <field name="semester">3</field>
        <field name="term_type">odd</field>
        <field name="program_id" ref="demo_program_if"/>
        <field name="prerequisite_ids" eval="[(6, 0, [ref('demo_subject_if101')])]"/>
    </record>
    <record id="demo_subject_if203" model="academic.subject">
        <field name="name">Pemrograman Web</field>
        <field name="code">IF203</field>
        <field name="credits">3</field>
        <field name="semester">3</field>
        <field name="term_type">odd</field>
        <field name="program_id" ref="demo_program_if"/>
        <field name="prerequisite_ids" eval="[(6, 0, [ref('demo_subject_if101')])]"/>
    </record>

    <!-- ========================== MANAJEMEN ========================== -->
    <record id="demo_subject_mn101" model="academic.subject">
        <field name="name">Pengantar Manajemen</field>
        <field name="code">MN101</field>
        <field name="credits">3</field>
