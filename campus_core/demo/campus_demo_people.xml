<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Staff and students.

         The employees are created here, without an academic role: academic_role
         is a campus_employees field and this module must not know about it.
         campus_employees gives them their roles and jurisdictions, and does so
         after these exist. -->

    <!-- ============================= LECTURERS ============================ -->
    <record id="demo_emp_budi" model="hr.employee">
        <field name="name">Dr. Budi Hartono, M.Kom.</field>
        <field name="work_email">budi.hartono@kampus.test</field>
    </record>
    <record id="demo_emp_siti" model="hr.employee">
        <field name="name">Siti Rahmawati, M.T.</field>
        <field name="work_email">siti.rahmawati@kampus.test</field>
    </record>
    <record id="demo_emp_andi" model="hr.employee">
        <field name="name">Andi Pratama, M.Sc.</field>
