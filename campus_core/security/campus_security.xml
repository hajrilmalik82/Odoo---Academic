<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Module Category -->
        <record id="module_category_campus" model="ir.module.category">
            <field name="name">Campus Academic</field>
            <field name="description">Helps you manage your Campus Master Data, Curriculums, and KRS.</field>
            <field name="sequence">10</field>
        </record>

        <record id="privilege_campus_academic" model="res.groups.privilege">
            <field name="name">Role</field>
            <field name="category_id" ref="module_category_campus"/>
        </record>

        <!-- Groups -->
        <record id="group_campus_lecturer" model="res.groups">
            <field name="name">Lecturer</field>
            <field name="privilege_id" ref="privilege_campus_academic"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_campus_academic_staff" model="res.groups">
            <field name="name">Academic Staff (TU)</field>
            <field name="privilege_id" ref="privilege_campus_academic"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_campus_administrator" model="res.groups">
            <field name="name">Administrator</field>
            <field name="privilege_id" ref="privilege_campus_academic"/>
            <field name="implied_ids" eval="[(4, ref('group_campus_lecturer')), (4, ref('group_campus_academic_staff')), (4, ref('hr.group_hr_manager'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>

    <data noupdate="1">


        <record id="rule_admin_krs_access" model="ir.rule">
            <field name="name">Campus Admin: All KRS Access</field>
            <field name="model_id" ref="model_academic_krs"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('campus_core.group_campus_administrator'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <record id="rule_admin_khs_access" model="ir.rule">
            <field name="name">Campus Admin: All KHS Access</field>
            <field name="model_id" ref="model_academic_khs"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('campus_core.group_campus_administrator'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <!-- Academic staff maintain student master data, so they keep write on
             res.partner, but only on students. Without this they could edit any
             contact in the database, vendors and customers included.

             Deliberately scoped to write: perm_read stays 0 so reading contacts
             is untouched, and perm_create stays 0 so the rest of Odoo keeps
             working. A read restriction on res.partner would break name display,
             mail and reports across the whole system. -->
        <record id="rule_academic_staff_partner_write" model="ir.rule">
            <field name="name">Academic Staff: Only Edit Student Contacts</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="domain_force">[('is_student', '=', True)]</field>
            <field name="groups" eval="[(4, ref('campus_core.group_campus_academic_staff'))]"/>
            <field name="perm_read" eval="0"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <!-- group_campus_administrator implies group_campus_academic_staff, so
             the rule above would otherwise limit administrators to students too.
             Group rules are OR'ed, so this restores their full write access. -->
        <record id="rule_admin_partner_write" model="ir.rule">
            <field name="name">Campus Admin: Edit Any Contact</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('campus_core.group_campus_administrator'))]"/>
            <field name="perm_read" eval="0"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <!-- Without this rule administrators see almost no grade lines at all.
             group_campus_administrator implies group_campus_lecturer, so the
             lecturer rule below was the only one matching their groups, and it
             narrows the model to the classes that person teaches. Rules of
             different groups are OR'ed, so this one restores full visibility to
             administrators while leaving the lecturer rule binding on lecturers. -->
        <record id="rule_admin_khs_line_access" model="ir.rule">
            <field name="name">Campus Admin: All KHS Lines</field>
            <field name="model_id" ref="model_academic_khs_line"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('campus_core.group_campus_administrator'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <!-- Scope lecturers to the students they advise. The ACL grants them
             read and write on academic.krs, and until now no rule matched their
             group at all, so every lecturer could read and change the study plan
             of every student in the university. A lecturer's business with a KRS
             is approving, rejecting or returning their own advisee's.
             Administrators are unaffected: they match rule_admin_krs_access,
             and group rules are OR'ed. -->
        <record id="rule_lecturer_krs_access" model="ir.rule">
            <field name="name">Lecturer: Only KRS of Their Own Advisees</field>
            <field name="model_id" ref="model_academic_krs"/>
            <field name="domain_force">[('student_id.academic_advisor_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('campus_core.group_campus_lecturer'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <record id="rule_lecturer_khs_line_write" model="ir.rule">
            <field name="name">Lecturer: Only Write KHS for Subjects They Teach</field>
            <field name="model_id" ref="model_academic_khs_line"/>
            <field name="domain_force">[('schedule_ids.lecturer_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('campus_core.group_campus_lecturer'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <!-- Read-only. Students never write through the ORM directly: the portal
             controller verifies ownership and performs the change with sudo().
             Granting write here once let a student bypass every submission rule
             by calling write({'state': 'submitted'}) over /web/dataset/call_kw. -->
        <record id="rule_student_own_krs" model="ir.rule">
            <field name="name">Student can only see own KRS</field>
            <field name="model_id" ref="model_academic_krs"/>
            <field name="domain_force">[('student_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <record id="rule_student_own_krs_line" model="ir.rule">
            <field name="name">Student can only see own KRS Lines</field>
            <field name="model_id" ref="model_academic_krs_line"/>
            <field name="domain_force">[('krs_id.student_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <record id="rule_student_own_khs" model="ir.rule">
            <field name="name">Student can only see own KHS</field>
            <field name="model_id" ref="model_academic_khs"/>
            <field name="domain_force">[('student_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <record id="rule_student_own_khs_line" model="ir.rule">
            <field name="name">Student can only see own KHS Lines</field>
            <field name="model_id" ref="model_academic_khs_line"/>
            <field name="domain_force">[('khs_id.student_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>
    </data>
</odoo>
