<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Public student admission is now served by the standalone React
         frontend-app via the /api/admission/* JSON endpoints. Clean up any
         previously installed /admission website menu item and QWeb templates. -->
    <function model="website.menu" name="unlink"
              eval="[obj().env['website.menu'].search([('url', '=', '/admission')]).ids]"/>
    <delete model="ir.ui.view"
            search="[('key', 'in', ('campus_pmb.admission_form', 'campus_pmb.admission_thanks'))]"/>
</odoo>
