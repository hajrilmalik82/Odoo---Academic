<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="pmb_homepage_docs" inherit_id="campus_website.core_homepage_docs" name="PMB ERP Documentation">

        <!-- Inject into Sidebar Navigation -->
        <xpath expr="//div[@id='docs-tab']" position="inside">
            <button class="nav-link fw-bold py-3 text-start mb-1 text-danger" id="tab-pmb" data-bs-toggle="pill" data-bs-target="#content-pmb" type="button" role="tab" aria-controls="content-pmb" aria-selected="false">
                <i class="fa fa-graduation-cap me-2"/> PMB Admission (New Students)
            </button>
        </xpath>

        <!-- Inject into Content Area -->
        <xpath expr="//div[@id='docs-tabContent']" position="inside">

            <!-- MODUL PMB PANE -->
            <div class="tab-pane fade" id="content-pmb" role="tabpanel" aria-labelledby="tab-pmb">
                <section class="mb-5">
                    <div class="d-flex align-items-center mb-4">
                        <div class="bg-danger text-white rounded-circle d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 50px; height: 50px; font-size: 1.25rem;">
                            <i class="fa fa-graduation-cap"/>
                        </div>
                        <h2 class="fw-bold mb-0 text-danger">PMB Module (New Student Admissions)</h2>
                    </div>
                    <p class="text-muted lead mb-4">
                        This module handles the entire new student admissions process—from online or office registration, document verification, acceptance decisions, up to creating the official Student ID (NIM) and Portal login account.
                    </p>

                    <!-- HIGHLIGHT FITUR -->
                    <div class="row mb-5">
                        <div class="col-md-4">
                            <div class="card border-0 shadow-sm h-100 rounded-4">
                                <div class="card-body">
                                    <h5 class="fw-bold text-dark"><i class="fa fa-shield text-danger me-2"/>Faculty-Scoped Access</h5>
                                    <p class="text-muted small mb-0">PMB Committee members only see and process applicants applying to the Faculty or Study Program within their assigned work area.</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card border-0 shadow-sm h-100 rounded-4">
                                <div class="card-body">
                                    <h5 class="fw-bold text-dark"><i class="fa fa-filter text-primary me-2"/>Quick Filtering</h5>
                                    <p class="text-muted small mb-0">Use the left-hand Search Panel in the Admissions list to filter applicants with one click by Faculty, Study Program, or Status.</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card border-0 shadow-sm h-100 rounded-4">
                                <div class="card-body">
                                    <h5 class="fw-bold text-dark"><i class="fa fa-cogs text-success me-2"/>Document &amp; Status Checks</h5>
                                    <p class="text-muted small mb-0">The system prevents accepting an applicant if required documents are still missing, and protects already-registered students from accidental rejection.</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <h4 class="fw-bold border-bottom pb-2 mb-4">Step-by-Step Admissions Workflow</h4>

                    <!-- TAHAP 1 -->
                    <div class="mb-4 ps-4 border-start border-4 border-secondary position-relative">
                        <span class="badge bg-secondary position-absolute" style="left: -15px; top: 0px; font-size: 1rem;">1</span>
                        <h5 class="fw-bold text-dark pt-1">Stage 1: Applicant Registration (Draft)</h5>
                        <p class="mb-2"><strong>Who performs this:</strong> Prospective Student (Online) or PMB Committee (Office)</p>
                        <p class="mb-2">The applicant fills in personal data, email, phone, and desired Study Program. The system automatically assigns a unique Registration Number (e.g. <code>PMB/2026/0001</code>) and sets the status to <em>Draft</em>.</p>
                        <div class="bg-light p-3 rounded">
                            <i class="fa fa-exclamation-triangle text-danger me-2"/> <strong>System Rules &amp; Validations:</strong>
                            <ul class="mb-0 mt-1 text-muted small">
                                <li>Full name, valid email, chosen Faculty, and Study Program must be filled in before the application can be submitted.</li>
                                <li>Click <strong>Submit</strong> when the initial data is ready to move to Document Review.</li>
                            </ul>
                        </div>
                    </div>

                    <!-- TAHAP 2 -->
                    <div class="mb-4 ps-4 border-start border-4 border-warning position-relative">
                        <span class="badge bg-warning text-dark position-absolute" style="left: -15px; top: 0px; font-size: 1rem;">2</span>
                        <h5 class="fw-bold text-dark pt-1">Stage 2: Document Review &amp; Checklist</h5>
                        <p class="mb-2"><strong>Who performs this:</strong> PMB Committee</p>
                        <p class="mb-2">When submitted, the system automatically creates a <strong>Document Checklist</strong> (e.g., Diploma, ID Card, Photo) based on the applicant's admission path. Check and mark each submitted document as verified.</p>
                        <div class="bg-light p-3 rounded">
                            <i class="fa fa-exclamation-triangle text-danger me-2"/> <strong>System Rules &amp; Validations:</strong>
                            <ul class="mb-0 mt-1 text-muted small">
                                <li><strong>100% Mandatory Documents Required:</strong> You <strong>cannot</strong> click <em>Accept</em> if any mandatory document in the checklist is still marked missing or unverified. Complete and verify all required items first.</li>
                            </ul>
                        </div>
                    </div>

                    <!-- TAHAP 3 -->
                    <div class="mb-4 ps-4 border-start border-4 border-primary position-relative">
                        <span class="badge bg-primary position-absolute" style="left: -15px; top: 0px; font-size: 1rem;">3</span>
                        <h5 class="fw-bold text-dark pt-1">Stage 3: Acceptance Decision</h5>
                        <p class="mb-2"><strong>Who performs this:</strong> PMB Committee / Administrator</p>
                        <p class="mb-2">Once all required documents are verified and the applicant passes selection, click <strong>Accept</strong>. The status changes to <em>Accepted</em>.</p>
                    </div>

                    <!-- TAHAP 4 -->
                    <div class="mb-4 ps-4 border-start border-4 border-success position-relative">
                        <span class="badge bg-success position-absolute" style="left: -15px; top: 0px; font-size: 1rem;">4</span>
                        <h5 class="fw-bold text-dark pt-1">Stage 4: Final Enrollment (Create NIM &amp; Student Account)</h5>
                        <p class="mb-2"><strong>Who performs this:</strong> PMB Committee / Administrator</p>
                        <p class="mb-2">Click <strong>Register Student</strong> on an <em>Accepted</em> application. The system automatically completes four tasks at once:</p>
                        <ul class="text-muted mt-2 mb-2">
                            <li><strong>Generates Official NIM:</strong> Creates the Student Registration Number (NIM) based on Faculty, Study Program, and Enrollment Year.</li>
                            <li><strong>Creates Student Profile:</strong> Adds the applicant to the official Student directory linked to their Faculty and Study Program.</li>
                            <li><strong>Creates Portal Account:</strong> Sets up a Student Portal login account using the applicant's email address as their username.</li>
                            <li><strong>Grants Portal Access:</strong> Enables the student to log in immediately to view schedules and fill out KRS.</li>
                        </ul>
                        <div class="bg-light p-3 rounded">
                            <i class="fa fa-exclamation-triangle text-danger me-2"/> <strong>System Rules &amp; Validations:</strong>
                            <ul class="mb-0 mt-1 text-muted small">
                                <li>An applicant can only be registered once. Make sure the applicant's email is unique and not already used by another portal account.</li>
                            </ul>
                        </div>
                    </div>

                    <!-- TAHAP 5 -->
                    <div class="mb-4 ps-4 border-start border-4 border-danger position-relative">
                        <span class="badge bg-danger position-absolute" style="left: -15px; top: 0px; font-size: 1rem;">5</span>
                        <h5 class="fw-bold text-dark pt-1">Stage 5: Rejecting an Application</h5>
                        <p class="mb-2"><strong>Who performs this:</strong> PMB Committee / Administrator</p>
                        <p class="mb-2">If an applicant does not meet requirements (for example, invalid documents or failed selection), click <strong>Reject</strong> from the form or the <em>Actions</em> menu.</p>
                        <div class="bg-light p-3 rounded">
                            <i class="fa fa-exclamation-triangle text-danger me-2"/> <strong>System Rules &amp; Validations:</strong>
                            <ul class="mb-0 mt-1 text-muted small">
                                <li><strong>Protected Final Statuses:</strong> Applications that are already <em>Accepted</em> or <em>Registered</em> <strong>cannot</strong> be rejected, preventing accidental cancellation after a Student ID and account have been issued.</li>
                            </ul>
                        </div>
                    </div>

                    <!-- SECTION: PENDAFTARAN ONLINE -->
                    <h4 class="fw-bold border-bottom pb-2 mb-4 mt-5">Online Self-Registration (Public Website)</h4>
                    <p class="text-muted mb-3">Prospective students can apply directly from the campus website without logging in first:</p>
                    <div class="bg-light p-3 rounded mb-2">
                        <i class="fa fa-globe text-primary me-2"/> <strong>Step 1 — Open Registration Form:</strong> Go to <strong>/admission</strong> (or click <em>PMB Admission</em> in the top menu), fill in personal details, and click <strong>Submit Application</strong>. A new <em>Draft</em> application is created automatically.
                    </div>
                    <div class="bg-light p-3 rounded mb-2">
                        <i class="fa fa-filter text-info me-2"/> <strong>Step 2 — Choosing Faculty &amp; Program:</strong> After choosing a Faculty, the Study Program list automatically narrows down to only programs inside that Faculty so applicants cannot pick a mismatched combination.
                    </div>
                    <div class="bg-light p-3 rounded">
                        <i class="fa fa-calendar-check-o text-success me-2"/> <strong>Step 3 — Active Academic Year:</strong> Applicants do not need to pick the Academic Year—the system automatically links the application to the currently active Academic Year, and the PMB Committee reviews it from the backend.
                    </div>

                    <!-- SECTION: PERAN & HAK AKSES PMB -->
                    <h4 class="fw-bold border-bottom pb-2 mb-4 mt-5">Who Can Do What (PMB Roles)</h4>
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover align-middle">
                            <thead class="table-dark">
                                <tr>
                                    <th>Task</th>
                                    <th class="text-center">Applicant (Public)</th>
                                    <th class="text-center">PMB Committee</th>
                                    <th class="text-center">Administrator</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>Submit online application (/admission)</td>
                                    <td class="text-center text-success fw-bold">✓</td>
                                    <td class="text-center text-success fw-bold">✓</td>
                                    <td class="text-center text-success fw-bold">✓</td>
                                </tr>
                                <tr>
                                    <td>Verify documents</td>
                                    <td class="text-center text-danger">✗</td>
                                    <td class="text-center text-success fw-bold">✓ (assigned programs only)</td>
                                    <td class="text-center text-success fw-bold">✓ (all)</td>
                                </tr>
                                <tr>
                                    <td>Accept / Reject applicant</td>
                                    <td class="text-center text-danger">✗</td>
                                    <td class="text-center text-success fw-bold">✓ (assigned programs only)</td>
                                    <td class="text-center text-success fw-bold">✓ (all)</td>
                                </tr>
                                <tr>
                                    <td>Register Student (Create NIM &amp; Account)</td>
                                    <td class="text-center text-danger">✗</td>
                                    <td class="text-center text-success fw-bold">✓ (assigned programs only)</td>
                                    <td class="text-center text-success fw-bold">✓ (all)</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                </section>
            </div>
        </xpath>
    </template>
</odoo>
