<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- No hr.employee form page here any more. PMB jurisdiction is a row on
         campus.jurisdiction with scope='pmb', shown on the single Jurisdiction
         page campus_employees declares. This module only adds the scope value. -->

    <!-- Moved here from campus_employees together with the 'pmb' role itself:
         the action filters on a selection value that only exists once this
         module is installed, and the menu it hangs off pointed at an action
         campus_employees could not supply on its own. -->
    <record id="action_hr_employee_pmb_staff" model="ir.actions.act_window">
        <field name="name">PMB Staff</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('academic_role', '=', 'pmb')]</field>
        <field name="context">{'default_academic_role': 'pmb'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new PMB Staff
            </p>
        </field>
    </record>

    <menuitem id="menu_academic_pmb_staff"
              name="PMB Staff"
              parent="campus_core.menu_academic_people"
              action="action_hr_employee_pmb_staff"
              sequence="30"/>
</odoo>
