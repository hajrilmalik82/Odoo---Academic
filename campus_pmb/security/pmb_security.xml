<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="group_pmb" model="res.groups">
            <field name="name">PMB Staff</field>
            <field name="privilege_id" ref="campus_core.privilege_campus_academic"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="campus_core.group_campus_administrator" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('campus_pmb.group_pmb'))]"/>
        </record>

    </data>
    <data noupdate="1">
        <!-- Record Rule for PMB Officers (Filtered Access) -->
        <record id="rule_pmb_admission_access" model="ir.rule">
            <field name="name">PMB: Faculty and Program Access</field>
            <field name="model_id" ref="model_campus_admission"/>
            <!-- Built in Python so the rule stays readable and testable. The
                 inline version AND'ed both dimensions as `in []` whenever an
                 assignment list was left empty, so an officer given a whole
                 faculty but no specific programme saw zero admissions. -->
            <field name="domain_force">user.employee_id._pmb_admission_domain()</field>
            <field name="groups" eval="[(4, ref('campus_pmb.group_pmb'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <!-- The jurisdiction has to reach the document checklist too. It was
             enforced on campus.admission but not here, and no other rule matched
             this group, so an officer scoped to one faculty could read and edit
             the documents of applicants to every other faculty. -->
        <record id="rule_pmb_admission_document_access" model="ir.rule">
            <field name="name">PMB: Documents Follow Admission Jurisdiction</field>
            <field name="model_id" ref="model_campus_admission_document"/>
            <field name="domain_force">user.employee_id._pmb_admission_domain('admission_id.program_id')</field>
            <field name="groups" eval="[(4, ref('campus_pmb.group_pmb'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <!-- group_campus_administrator implies group_pmb, so the rule above would
             otherwise narrow administrators to one officer's jurisdiction. -->
        <record id="rule_admin_admission_document_access" model="ir.rule">
            <field name="name">Campus Admin: All Admission Documents</field>
            <field name="model_id" ref="model_campus_admission_document"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('campus_core.group_campus_administrator'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <!-- Record Rule for Administrators (All Access) -->
        <record id="rule_admin_admission_access" model="ir.rule">
            <field name="name">Campus Admin: All Admissions Access</field>
            <field name="model_id" ref="model_campus_admission"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('campus_core.group_campus_administrator'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>
    </data>
</odoo>
