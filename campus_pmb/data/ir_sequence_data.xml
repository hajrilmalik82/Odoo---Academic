<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_campus_admission" model="ir.sequence">
            <field name="name">Campus Admission</field>
            <field name="code">campus.admission</field>
            <field name="prefix">PMB/%(year)s/</field>
            <field name="padding">5</field>
            <!-- Global: without this the sequence binds to the company that
                 happened to install the module, and next_by_code returns nothing
                 in any other company, leaving every record named "New". -->
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
