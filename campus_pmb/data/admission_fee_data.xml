<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate="1": default admission fees for registration and re-registration.
         Administrators and PMB staff can adjust these or add per-program rules from
         Admissions > Configuration > Admission Fees. -->
    <data noupdate="1">

        <record id="fee_registration_regular" model="campus.admission.fee">
            <field name="sequence">10</field>
            <field name="fee_type">registration</field>
            <field name="admission_path">regular</field>
            <field name="amount">250000</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="fee_registration_transfer" model="campus.admission.fee">
            <field name="sequence">20</field>
            <field name="fee_type">registration</field>
            <field name="admission_path">transfer</field>
            <field name="amount">350000</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="fee_registration_scholarship" model="campus.admission.fee">
            <field name="sequence">30</field>
            <field name="fee_type">registration</field>
            <field name="admission_path">scholarship</field>
            <field name="amount">0</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="fee_reregistration_all" model="campus.admission.fee">
            <field name="sequence">40</field>
            <field name="fee_type">reregistration</field>
            <field name="admission_path">all</field>
            <field name="amount">4500000</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="fee_reregistration_scholarship" model="campus.admission.fee">
            <field name="sequence">50</field>
            <field name="fee_type">reregistration</field>
            <field name="admission_path">scholarship</field>
            <field name="amount">0</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>

