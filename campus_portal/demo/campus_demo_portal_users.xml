<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Portal logins for two of the students, so /my/krs and /my/khs can be
         seen from a student's side rather than described.

         Ahmad has a locked study plan behind him and a draft one open, so his
         portal shows both halves: last term's transcript and this term's form
         with the Ambil buttons live. Siti Aisyah failed a subject last term,
         so her transcript is the one that shows SKS Lulus below SKS Dinilai. -->

    <record id="demo_portal_user_ahmad" model="res.users">
        <field name="name">Ahmad Fauzi</field>
        <field name="login">ahmad.fauzi@mahasiswa.test</field>
        <field name="password">demo123</field>
        <field name="partner_id" ref="campus_core.demo_student_if_01"/>
        <field name="group_ids" eval="[(6, 0, [ref('base.group_portal')])]"/>
    </record>

    <record id="demo_portal_user_aisyah" model="res.users">
        <field name="name">Siti Aisyah</field>
        <field name="login">siti.aisyah@mahasiswa.test</field>
        <field name="password">demo123</field>
        <field name="partner_id" ref="campus_core.demo_student_if_04"/>
        <field name="group_ids" eval="[(6, 0, [ref('base.group_portal')])]"/>
    </record>
</odoo>
