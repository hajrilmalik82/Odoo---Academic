#: model_terms:ir.ui.view,arch_db:campus_portal.portal_homepage_docs
msgid "Stage 1: Logging In &amp; Opening Your Dashboard"
msgstr "Tahap 1: Login &amp; Membuka Halaman Utama Portal"

#. module: campus_portal
#: model_terms:ir.ui.view,arch_db:campus_portal.portal_homepage_docs
msgid "<strong>Who performs this:</strong> Student"
msgstr "<strong>Pelaksana:</strong> Mahasiswa"

#. module: campus_portal
#: model_terms:ir.ui.view,arch_db:campus_portal.portal_homepage_docs
msgid ""
"Log in using your campus email and password, then open <strong>My "
"Account</strong> (<code>/my/home</code>). From the dashboard you can jump "
"directly to your <strong>KRS</strong>, <strong>KHS</strong>, or "
"<strong>Thesis</strong> pages."
msgstr ""
"Login menggunakan email kampus dan kata sandi Anda, lalu buka <strong>Akun "
"Saya</strong> (<code>/my/home</code>). Dari halaman ini Anda dapat langsung "
"membuka menu <strong>KRS</strong>, <strong>KHS</strong>, atau "
"<strong>Skripsi</strong>."

#. module: campus_portal
#: model_terms:ir.ui.view,arch_db:campus_portal.portal_homepage_docs
