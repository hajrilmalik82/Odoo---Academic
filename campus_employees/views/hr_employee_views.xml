<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_inherit_academic" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.academic</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <!-- What is attached to this person, as counts beside Contacts and
                 History. These are the five links the move guard refuses a move
                 over, so a refusal that names six schedules now has somewhere to
                 send the reader.

                 groups= names the lecturer and the academic staff groups, not
                 one of them: campus_core/security/campus_security.xml makes the
                 three campus groups siblings, each implying only base.group_user,
                 and only Administrator implies the other two. Naming the lecturer
                 group alone would have hidden the buttons from the academic staff
                 who do most of this work.

                 Shown whenever the person is a lecturer, including at zero.
                 Hiding an empty counter reads as a broken button rather than
                 as an answer, and "0 Advisees" is an answer. Nobody who is
                 not a lecturer gets them at all. -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_advisees" type="object"
                        class="oe_stat_button" icon="fa-graduation-cap"
                        invisible="academic_role != 'lecturer'"
                        groups="campus_core.group_campus_lecturer,campus_core.group_campus_academic_staff">
                    <field name="advisee_count" widget="statinfo" string="Advisees"/>
                </button>
                <button name="action_open_schedules" type="object"
                        class="oe_stat_button" icon="fa-calendar"
                        invisible="academic_role != 'lecturer'"
                        groups="campus_core.group_campus_lecturer,campus_core.group_campus_academic_staff">
                    <field name="schedule_count" widget="statinfo" string="Schedules"/>
                </button>
                <button name="action_open_sessions" type="object"
                        class="oe_stat_button" icon="fa-clock-o"
                        invisible="academic_role != 'lecturer'"
                        groups="campus_core.group_campus_lecturer,campus_core.group_campus_academic_staff">
                    <field name="session_count" widget="statinfo" string="Sessions"/>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Lecturer Profile" invisible="academic_role != 'lecturer'">
                    <!-- The way to gain an advisee. Creation is off on the
                         Advisees list because a student is born in the
                         admissions flow, not here; this is what takes its
                         place. Shown to the people who may write to a student
                         record at all - the ACL grants res.partner write to the
                         academic staff and the administrator, not to lecturers. -->
                    <div class="mb-3">
                        <button name="action_assign_advisees" type="object"
                                string="Assign Students" icon="fa-user-plus"
                                class="btn-secondary"
                                groups="campus_core.group_campus_academic_staff,campus_core.group_campus_administrator"/>
                    </div>
                    <group>
                        <group>
                            <field name="academic_role" invisible="1"/>
                            <field name="nidn"/>
                            <field name="academic_rank"/>
                            <field name="faculty_id"/>
                            <field name="program_id"/>
                        </group>
                        <!-- Posts are at most one each, so a counter would read
                             "1" and say nothing. The record itself is the useful
                             answer, and the field is hidden when there is none
                             rather than showing an empty row. -->
                        <group string="Posts Held"
                               invisible="not dean_of_faculty_id and not head_of_program_id">
                            <field name="dean_of_faculty_id" readonly="1"
                                   invisible="not dean_of_faculty_id"/>
                            <field name="head_of_program_id" readonly="1"
                                   invisible="not head_of_program_id"/>
                        </group>
                    </group>
                </page>
                <!-- One page for every purpose, not one per module. This used
                     to be two near-identical pages - Academic Jurisdiction here
                     and PMB Jurisdiction in campus_pmb - over two parallel sets
                     of four fields. A module that adds a scope now needs no view
                     change at all: its rows simply appear in this list.
                     The page is shown only to campus administrators, which is
                     also who the ACL on campus.jurisdiction admits. -->
                <page string="Jurisdiction" name="campus_jurisdiction"
                      groups="campus_core.group_campus_administrator"
                      invisible="academic_role not in ('academic', 'pmb')">
                    <field name="jurisdiction_ids">
                        <list editable="bottom">
                            <field name="scope"/>
                            <field name="all_faculties"/>
                            <field name="faculty_ids" widget="many2many_tags"
                                   column_invisible="0" invisible="all_faculties"/>
                            <field name="all_programs"/>
                            <field name="program_ids" widget="many2many_tags"
                                   invisible="all_programs"/>
                        </list>
                    </field>
                </page>
            </xpath>
            <!-- The stock keys are restated, not dropped. position="attributes"
                 with no add= replaces the attribute outright
                 (odoo/tools/template_inheritance.py:306-309), and the stock
                 job_id in hr.view_employee_form carries
                 {'default_no_of_recruitment': 0, 'default_is_favorite': False}.
                 Losing them meant a Job Position created inline from this form
                 got a recruitment target of 1 instead of 0 and, with
                 hr_recruitment installed, was silently favourited for whoever
                 created it - a phantom open position for every lecturer job. -->
            <xpath expr="//field[@name='job_id']" position="attributes">
                <attribute name="context">{'default_no_of_recruitment': 0, 'default_is_favorite': False, 'default_academic_role': context.get('default_academic_role')}</attribute>
            </xpath>
        </field>
    </record>

    <!-- Action for Academic Staff -->
    <record id="action_hr_employee_academic_staff" model="ir.actions.act_window">
        <field name="name">Academic Staff</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('academic_role', '=', 'academic')]</field>
        <field name="context">{'default_academic_role': 'academic'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Academic Staff (Staf TU)
            </p>
        </field>
    </record>
</odoo>
