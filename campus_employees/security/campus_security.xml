<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate="1", matching campus_core, campus_pmb and stock. These are
         security rules: an administrator who narrows one on a live database
         should not have it silently restored by the next module upgrade. A
         genuine correction to a rule ships as a migrations/<version>/
         post-migrate.py that writes the new domain_force deliberately. -->
    <data noupdate="1">
        <!-- The teaching timetable is deliberately NOT scoped by jurisdiction.
             academic.class, academic.class.schedule and academic.class.session
             carry full CRUD for academic staff with no rule below, while every
             student record - academic.krs, academic.khs and both line models -
             is narrowed to the officer's faculties and programmes.

             That asymmetry is the decision, not an oversight. A study plan and
             a transcript belong to one student in one programme, so restricting
             them by programme is restricting them by whose records they are. A
             timetable is shared infrastructure: rooms are booked across
             faculties, a lecturer of one faculty teaches a service subject for
             another, and clash detection in academic_class_schedule.py only
             works if it can see every booking in the slot. Scoping it would
             split one timetable into several that cannot see each other, and
             the overlap constraints would stop catching the conflicts they
             exist for.

             If an institution does want it scoped, all three models have to
             move together - a rule on sessions alone leaves the schedules they
             are generated from wide open - and the clash checks need sudo()
             first so they keep seeing the whole room. -->
        <record id="rule_academic_staff_krs_access" model="ir.rule">
            <field name="name">Academic Staff: Faculty and Program Access for KRS</field>
            <field name="model_id" ref="campus_core.model_academic_krs"/>
            <!-- See _build_jurisdiction_domain: an empty assignment list means
                 "no restriction on that dimension", as the field help says. The
                 inline version turned it into `in []`, which matched nothing. -->
            <field name="domain_force">user.employee_id._academic_jurisdiction_domain('program_id')</field>
            <field name="groups" eval="[(4, ref('campus_core.group_campus_academic_staff'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <record id="rule_academic_staff_khs_access" model="ir.rule">
            <field name="name">Academic Staff: Faculty and Program Access for KHS</field>
            <field name="model_id" ref="campus_core.model_academic_khs"/>
            <field name="domain_force">user.employee_id._academic_jurisdiction_domain('student_id.program_id')</field>
            <field name="groups" eval="[(4, ref('campus_core.group_campus_academic_staff'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <!-- The jurisdiction has to reach the grade lines too. It was enforced on
             academic.khs but not on academic.khs.line, and no other rule matched
             this group there, so staff could read and edit the grades of every
             student in the university simply by going at the line model directly.
             Held back until now because the domain builder above had to be fixed
             first: copied as it was, it would have shown them nothing. -->
        <record id="rule_academic_staff_khs_line_access" model="ir.rule">
            <field name="name">Academic Staff: Faculty and Program Access for KHS Lines</field>
            <field name="model_id" ref="campus_core.model_academic_khs_line"/>
            <field name="domain_force">user.employee_id._academic_jurisdiction_domain('khs_id.student_id.program_id')</field>
            <field name="groups" eval="[(4, ref('campus_core.group_campus_academic_staff'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <!-- The jurisdiction has to reach the KRS lines too. It was enforced on
             academic.krs but not on its lines, and the line model stores its own
             student_id and state, so a staff member scoped to one faculty could
             read and edit the study-plan lines of every student in the
             university simply by querying the child model. -->
        <record id="rule_academic_staff_krs_line_access" model="ir.rule">
            <field name="name">Academic Staff: Faculty and Program Access for KRS Lines</field>
            <field name="model_id" ref="campus_core.model_academic_krs_line"/>
            <field name="domain_force">user.employee_id._academic_jurisdiction_domain('krs_id.program_id')</field>
            <field name="groups" eval="[(4, ref('campus_core.group_campus_academic_staff'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>
    </data>
</odoo>
