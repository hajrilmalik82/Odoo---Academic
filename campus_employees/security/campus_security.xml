<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate="1", matching campus_core, campus_pmb and stock. These are
         security rules: an administrator who narrows one on a live database
         should not have it silently restored by the next module upgrade. A
         genuine correction to a rule ships as a migrations/<version>/
         post-migrate.py that writes the new domain_force deliberately. -->
    <data noupdate="1">
        <!-- The teaching timetable is deliberately NOT scoped by jurisdiction.
             academic.class, academic.class.schedule and academic.class.session
             carry full CRUD for academic staff with no rule below, while every
             student record - academic.krs, academic.khs and both line models -
             is narrowed to the officer's faculties and programmes.

             That asymmetry is the decision, not an oversight. A study plan and
             a transcript belong to one student in one programme, so restricting
             them by programme is restricting them by whose records they are. A
             timetable is shared infrastructure: rooms are booked across
             faculties, a lecturer of one faculty teaches a service subject for
             another, and clash detection in academic_class_schedule.py only
             works if it can see every booking in the slot. Scoping it would
             split one timetable into several that cannot see each other, and
             the overlap constraints would stop catching the conflicts they
             exist for.

             If an institution does want it scoped, all three models have to
             move together - a rule on sessions alone leaves the schedules they
             are generated from wide open - and the clash checks need sudo()
             first so they keep seeing the whole room. -->
        <record id="rule_academic_staff_krs_access" model="ir.rule">
            <field name="name">Academic Staff: Faculty and Program Access for KRS</field>
            <field name="model_id" ref="campus_core.model_academic_krs"/>
            <field name="domain_force">user.employee_ids._academic_jurisdiction_domain('program_id')</field>
            <field name="groups" eval="[(4, ref('campus_core.group_campus_academic_staff'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <record id="rule_academic_staff_khs_access" model="ir.rule">
            <field name="name">Academic Staff: Faculty and Program Access for KHS</field>
            <field name="model_id" ref="campus_core.model_academic_khs"/>
            <field name="domain_force">user.employee_ids._academic_jurisdiction_domain('student_id.program_id')</field>
            <field name="groups" eval="[(4, ref('campus_core.group_campus_academic_staff'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <record id="rule_academic_staff_khs_line_access" model="ir.rule">
            <field name="name">Academic Staff: Faculty and Program Access for KHS Lines</field>
            <field name="model_id" ref="campus_core.model_academic_khs_line"/>
            <field name="domain_force">user.employee_ids._academic_jurisdiction_domain('khs_id.student_id.program_id')</field>
            <field name="groups" eval="[(4, ref('campus_core.group_campus_academic_staff'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <record id="rule_academic_staff_krs_line_access" model="ir.rule">
            <field name="name">Academic Staff: Faculty and Program Access for KRS Lines</field>
            <field name="model_id" ref="campus_core.model_academic_krs_line"/>
            <field name="domain_force">user.employee_ids._academic_jurisdiction_domain('krs_id.program_id')</field>
            <field name="groups" eval="[(4, ref('campus_core.group_campus_academic_staff'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <!-- Scope student reads for Academic Staff while leaving non-student
             contacts (companies, vendors, colleagues) readable so mail and
             other Odoo apps keep working. -->
        <record id="rule_academic_staff_partner_read" model="ir.rule">
            <field name="name">Academic Staff: Read Non-Students and In-Jurisdiction Students</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="domain_force">['|', ('is_student', '=', False)] + user.employee_ids._academic_jurisdiction_domain('program_id')</field>
            <field name="groups" eval="[(4, ref('campus_core.group_campus_academic_staff'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <record id="rule_admin_partner_read" model="ir.rule">
            <field name="name">Campus Admin: Read Any Contact</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('campus_core.group_campus_administrator'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <!-- Restrict non-HR campus users (Lecturers & Academic Staff) to reading
             academic colleagues and their own employee profile, preventing HR
             chatter and version-history leaks from non-academic personnel. -->
        <record id="rule_campus_employee_read_academic" model="ir.rule">
            <field name="name">Campus Roles: Only Read Academic Employees or Own Profile</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="domain_force">['|', ('academic_role', '!=', False), ('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('campus_core.group_campus_lecturer')), (4, ref('campus_core.group_campus_academic_staff'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <record id="rule_hr_and_admin_employee_read_all" model="ir.rule">
            <field name="name">HR &amp; Campus Admin: Read All Employees</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('hr.group_hr_user')), (4, ref('campus_core.group_campus_administrator'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <record id="rule_campus_hr_version_read_academic" model="ir.rule">
            <field name="name">Campus Roles: Only Read Academic Employee Versions</field>
            <field name="model_id" ref="hr.model_hr_version"/>
            <field name="domain_force">['|', ('employee_id.academic_role', '!=', False), ('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('campus_core.group_campus_lecturer')), (4, ref('campus_core.group_campus_academic_staff'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <record id="rule_hr_and_admin_hr_version_read_all" model="ir.rule">
            <field name="name">HR &amp; Campus Admin: Read All Employee Versions</field>
            <field name="model_id" ref="hr.model_hr_version"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('hr.group_hr_user')), (4, ref('campus_core.group_campus_administrator'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>
    </data>
</odoo>
