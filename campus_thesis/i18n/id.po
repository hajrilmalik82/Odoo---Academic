#. module: campus_thesis
#: model_terms:ir.ui.view,arch_db:campus_thesis.thesis_homepage_docs
msgid "<i class=\"fa fa-graduation-cap me-2\"/> Thesis, Yudisium &amp; Graduation"
msgstr "<i class=\"fa fa-graduation-cap me-2\"/> Skripsi, Yudisium &amp; Wisuda"

#. module: campus_thesis
#: model_terms:ir.ui.view,arch_db:campus_thesis.thesis_homepage_docs
msgid "Campus Thesis, Yudisium &amp; Graduation Module"
msgstr "Modul Skripsi, Yudisium &amp; Wisuda"

#. module: campus_thesis
#: model_terms:ir.ui.view,arch_db:campus_thesis.thesis_homepage_docs
msgid "This module guides final-year students, supervisors, academic advisors, and faculty deans through the complete thesis journey—from eligibility checks and supervisor approval, proposal and thesis progress, 3-step Yudisium clearance, to automatic placement in the nearest Graduation (Wisuda) schedule."
msgstr "Modul ini memandu mahasiswa tingkat akhir, dosen pembimbing, dosen PA, dan dekan fakultas melalui seluruh proses tugas akhir—mulai dari pengecekan syarat awal, persetujuan pembimbing, progres proposal dan skripsi, persetujuan yudisium 3 tahap, hingga penempatan otomatis ke jadwal wisuda terdekat."

#. module: campus_thesis
#: model_terms:ir.ui.view,arch_db:campus_thesis.thesis_homepage_docs
msgid "Step-by-Step Thesis &amp; Graduation Workflow"
msgstr "Alur Skripsi, Yudisium &amp; Wisuda Langkah demi Langkah"

#. module: campus_thesis
#: model_terms:ir.ui.view,arch_db:campus_thesis.thesis_homepage_docs
msgid "Stage 1: Thesis Registration &amp; Choosing a Supervisor"
msgstr "Tahap 1: Pendaftaran Skripsi &amp; Pemilihan Dosen Pembimbing"

#. module: campus_thesis
#: model_terms:ir.ui.view,arch_db:campus_thesis.thesis_homepage_docs
msgid "<strong>Who performs this:</strong> Student (via Portal <code>/my/thesis</code>) or Academic Admin"
msgstr "<strong>Pelaksana:</strong> Mahasiswa (lewat Portal <code>/my/thesis</code>) atau Admin Akademik"

#. module: campus_thesis
#: model_terms:ir.ui.view,arch_db:campus_thesis.thesis_homepage_docs
msgid "Enter the proposed <strong>Thesis Title</strong>, select a <strong>Primary Supervisor</strong> (required) and an optional Co-Supervisor, then click <strong>Submit to Supervisor</strong>."
msgstr "Masukkan rencana <strong>Judul Skripsi</strong>, pilih <strong>Pembimbing Utama</strong> (wajib) serta Pembimbing Pendamping (opsional), lalu klik <strong>Ajukan ke Pembimbing</strong>."

#. module: campus_thesis
#: model_terms:ir.ui.view,arch_db:campus_thesis.thesis_homepage_docs
msgid "<i class=\"fa fa-exclamation-triangle text-danger me-2\"/> <strong>System Rules &amp; Validations (What to check if blocked):</strong>"
msgstr "<i class=\"fa fa-exclamation-triangle text-danger me-2\"/> <strong>Aturan &amp; Validasi Sistem (Apa yang harus dicek jika tertahan):</strong>"

#. module: campus_thesis
#: model_terms:ir.ui.view,arch_db:campus_thesis.thesis_homepage_docs
msgid "<strong>Active Student Only:</strong> Only students with <em>Active</em> status can register a thesis."
msgstr "<strong>Khusus Mahasiswa Aktif:</strong> Hanya mahasiswa berstatus <em>Aktif</em> yang dapat mendaftarkan skripsi."

#. module: campus_thesis
#: model_terms:ir.ui.view,arch_db:campus_thesis.thesis_homepage_docs
msgid "<strong>Must Pass Research Methodology First:</strong> The student must have already passed a subject marked as <em>Research Methodology</em> in their graded KHS. If blocked, verify that the Research Methodology grade has been entered and is passing."
msgstr "<strong>Wajib Lulus Metode Penelitian Terlebih Dahulu:</strong> Mahasiswa harus sudah lulus mata kuliah bertanda <em>Metode Penelitian</em> di KHS yang sudah dinilai. Jika tertahan, pastikan nilai Metode Penelitian sudah diinput dan dinyatakan lulus."

#. module: campus_thesis
#: model_terms:ir.ui.view,arch_db:campus_thesis.thesis_homepage_docs
msgid "<strong>Valid Supervisors Only:</strong> Supervisors must be active Lecturers, and the Primary Supervisor and Co-Supervisor cannot be the same person."
msgstr "<strong>Pembimbing Harus Valid:</strong> Pembimbing harus berstatus Dosen aktif, dan Pembimbing Utama tidak boleh sama dengan Pembimbing Pendamping."

#. module: campus_thesis
#: model_terms:ir.ui.view,arch_db:campus_thesis.thesis_homepage_docs
msgid "Stage 2: Supervisor Review (Approve or Reject)"
msgstr "Tahap 2: Persetujuan atau Penolakan oleh Dosen Pembimbing"

#. module: campus_thesis
#: model_terms:ir.ui.view,arch_db:campus_thesis.thesis_homepage_docs
msgid "<strong>Who performs this:</strong> Primary Thesis Supervisor (Lecturer)"
msgstr "<strong>Pelaksana:</strong> Dosen Pembimbing Utama Skripsi"

#. module: campus_thesis
#: model_terms:ir.ui.view,arch_db:campus_thesis.thesis_homepage_docs
msgid "The assigned Primary Supervisor reviews the request and clicks <strong>Approve</strong> to open the Proposal stage, or <strong>Reject</strong> with a written reason."
msgstr "Dosen Pembimbing Utama meninjau pengajuan lalu klik <strong>Setujui</strong> untuk masuk ke tahap Proposal, atau klik <strong>Tolak</strong> disertai alasan tertulis."

#. module: campus_thesis
#: model_terms:ir.ui.view,arch_db:campus_thesis.thesis_homepage_docs
msgid "<i class=\"fa fa-exclamation-triangle text-danger me-2\"/> <strong>System Rules &amp; Validations:</strong>"
msgstr "<i class=\"fa fa-exclamation-triangle text-danger me-2\"/> <strong>Aturan &amp; Validasi Sistem:</strong>"

#. module: campus_thesis
#: model_terms:ir.ui.view,arch_db:campus_thesis.thesis_homepage_docs
msgid "<strong>If Rejected:</strong> The student or Admin can click <strong>Reset to Draft</strong>, revise the title or choose a different supervisor, and submit again."
msgstr "<strong>Jika Ditolak:</strong> Mahasiswa atau Admin dapat klik <strong>Kembalikan ke Draf</strong>, memperbaiki judul atau memilih pembimbing lain, lalu mengajukan ulang."

#. module: campus_thesis
#: model_terms:ir.ui.view,arch_db:campus_thesis.thesis_homepage_docs
msgid "<strong>Access Check:</strong> Only the assigned Primary Supervisor (or Admin) can approve or reject the request."
msgstr "<strong>Aturan Akses:</strong> Hanya Pembimbing Utama yang ditunjuk (atau Admin) yang dapat menyetujui atau menolak pengajuan."

#. module: campus_thesis
#: model_terms:ir.ui.view,arch_db:campus_thesis.thesis_homepage_docs
msgid "Stage 3: Proposal Stage &amp; Progress Logs"
msgstr "Tahap 3: Tahap Proposal &amp; Catatan Bimbingan"

#. module: campus_thesis
#: model_terms:ir.ui.view,arch_db:campus_thesis.thesis_homepage_docs
msgid "<strong>Who performs this:</strong> Student (logs progress) &amp; Primary Supervisor (reviews &amp; approves proposal)"
msgstr "<strong>Pelaksana:</strong> Mahasiswa (mencatat progres) &amp; Pembimbing Utama (menilai &amp; menyetujui proposal)"

#. module: campus_thesis
#: model_terms:ir.ui.view,arch_db:campus_thesis.thesis_homepage_docs
msgid "During the Proposal stage, the student records consultation milestones, notes, completion percentage, and optional file attachments. The supervisor reviews each log (<em>Approved</em> or <em>Needs Revision</em>) and clicks <strong>Approve Proposal</strong> when ready."
msgstr "Pada tahap Proposal, mahasiswa mencatat tahapan bimbingan, catatan, persentase progres, serta lampiran berkas. Pembimbing meninjau setiap catatan (<em>Disetujui</em> atau <em>Perlu Revisi</em>) dan klik <strong>Setujui Proposal</strong> jika sudah siap."

#. module: campus_thesis
#: model_terms:ir.ui.view,arch_db:campus_thesis.thesis_homepage_docs
msgid "<strong>File Upload Rules:</strong> Uploaded files must not be empty and cannot exceed <strong>10 MB</strong>."
msgstr "<strong>Aturan Unggah Berkas:</strong> Berkas yang diunggah tidak boleh kosong dan ukurannya maksimal <strong>10 MB</strong>."

#. module: campus_thesis
#: model_terms:ir.ui.view,arch_db:campus_thesis.thesis_homepage_docs
msgid "<strong>Before Moving to Thesis Stage:</strong> To advance from Proposal to Thesis Writing, the student <strong>must already be enrolled in a Thesis subject</strong> inside an <strong>Approved</strong> or <strong>Locked</strong> KRS. If blocked here, make sure the student's KRS containing the Thesis subject has been approved by their Academic Advisor."
msgstr "<strong>Syarat Masuk Tahap Skripsi:</strong> Untuk lanjut dari tahap Proposal ke tahap Skripsi, mahasiswa <strong>wajib sudah mengambil mata kuliah Skripsi</strong> pada KRS yang berstatus <strong>Disetujui</strong> atau <strong>Dikunci</strong>. Jika tertahan di langkah ini, pastikan KRS yang memuat mata kuliah Skripsi sudah disetujui oleh Dosen PA."

#. module: campus_thesis
#: model_terms:ir.ui.view,arch_db:campus_thesis.thesis_homepage_docs
msgid "Stage 4: Thesis Writing &amp; Supervisor Approval"
msgstr "Tahap 4: Tahap Penulisan Skripsi &amp; Persetujuan Pembimbing"

#. module: campus_thesis
#: model_terms:ir.ui.view,arch_db:campus_thesis.thesis_homepage_docs
msgid "<strong>Who performs this:</strong> Student &amp; Primary Supervisor"
msgstr "<strong>Pelaksana:</strong> Mahasiswa &amp; Pembimbing Utama"

#. module: campus_thesis
#: model_terms:ir.ui.view,arch_db:campus_thesis.thesis_homepage_docs
msgid "The student continues logging thesis consultations and drafts until completion. When finished, the Primary Supervisor clicks <strong>Approve Thesis</strong> to move the student into Yudisium Filing."
msgstr "Mahasiswa melanjutkan pencatatan bimbingan dan penyusunan naskah skripsi hingga selesai. Jika sudah layak, Pembimbing Utama klik <strong>Setujui Skripsi</strong> untuk masuk ke tahap Pemberkasan Yudisium."

#. module: campus_thesis
#: model_terms:ir.ui.view,arch_db:campus_thesis.thesis_homepage_docs
msgid "Stage 5: Yudisium Documents &amp; 3-Step Sequential Clearance"
msgstr "Tahap 5: Pemberkasan Yudisium &amp; Persetujuan Berjenjang 3 Tahap"

#. module: campus_thesis
#: model_terms:ir.ui.view,arch_db:campus_thesis.thesis_homepage_docs
msgid "<strong>Who performs this:</strong> Student / Admin (uploads documents), then Supervisor → Academic Advisor (PA) → Faculty Dean"
msgstr "<strong>Pelaksana:</strong> Mahasiswa / Admin (unggah berkas), lalu Pembimbing Skripsi → Dosen PA → Dekan Fakultas"

#. module: campus_thesis
#: model_terms:ir.ui.view,arch_db:campus_thesis.thesis_homepage_docs
msgid "<strong>Document Filing:</strong> Upload all required Yudisium clearance documents (via Portal or Backend) and verify them, then submit for Yudisium approval."
msgstr "<strong>Pemberkasan Dokumen:</strong> Unggah seluruh berkas syarat yudisium (lewat Portal atau Sistem) dan lakukan verifikasi, lalu ajukan untuk persetujuan yudisium."

#. module: campus_thesis
#: model_terms:ir.ui.view,arch_db:campus_thesis.thesis_homepage_docs
msgid "<strong>Step 1 — Thesis Supervisor Approval:</strong> Primary Supervisor confirms thesis clearance."
msgstr "<strong>Langkah 1 — Persetujuan Pembimbing Skripsi:</strong> Pembimbing Utama memberikan persetujuan yudisium."

#. module: campus_thesis
#: model_terms:ir.ui.view,arch_db:campus_thesis.thesis_homepage_docs
msgid "<strong>Step 2 — Academic Advisor (PA) Approval:</strong> The student's Academic Advisor confirms academic clearance."
msgstr "<strong>Langkah 2 — Persetujuan Dosen PA:</strong> Dosen Pembimbing Akademik mahasiswa memberikan persetujuan akademik."

#. module: campus_thesis
#: model_terms:ir.ui.view,arch_db:campus_thesis.thesis_homepage_docs
msgid "<strong>Step 3 — Faculty Dean Approval:</strong> The Faculty Dean gives the final Yudisium sign-off."
msgstr "<strong>Langkah 3 — Persetujuan Dekan Fakultas:</strong> Dekan Fakultas memberikan persetujuan akhir yudisium."

#. module: campus_thesis
#: model_terms:ir.ui.view,arch_db:campus_thesis.thesis_homepage_docs
msgid "<strong>Complete Documents Required:</strong> You cannot submit Yudisium if any mandatory document is still unuploaded or unverified."
msgstr "<strong>Berkas Wajib Harus Lengkap:</strong> Pengajuan yudisium tidak dapat dikirim jika masih ada berkas wajib yang belum diunggah atau belum diverifikasi."

#. module: campus_thesis
#: model_terms:ir.ui.view,arch_db:campus_thesis.thesis_homepage_docs
msgid "<strong>Strict Order:</strong> Approvals cannot skip steps—Supervisor must approve before PA, and PA must approve before the Dean."
msgstr "<strong>Urutan Tidak Boleh Dilompati:</strong> Persetujuan harus berurutan—Pembimbing Skripsi menyetujui lebih dulu sebelum Dosen PA, dan Dosen PA sebelum Dekan."

#. module: campus_thesis
#: model_terms:ir.ui.view,arch_db:campus_thesis.thesis_homepage_docs
msgid "<strong>Academic Advisor Required:</strong> If the student has no Academic Advisor assigned on their profile, Step 2 will be blocked until Academic Admin assigns one."
msgstr "<strong>Dosen PA Wajib Terisi:</strong> Jika mahasiswa belum memiliki Dosen PA di profilnya, Langkah 2 akan tertahan sampai Admin Akademik menetapkannya."

#. module: campus_thesis
#: model_terms:ir.ui.view,arch_db:campus_thesis.thesis_homepage_docs
msgid "Stage 6: Graduation &amp; Nearest Wisuda Schedule"
msgstr "Tahap 6: Kelulusan &amp; Penjadwalan Wisuda Terdekat"

#. module: campus_thesis
#: model_terms:ir.ui.view,arch_db:campus_thesis.thesis_homepage_docs
msgid "<strong>Who performs this:</strong> Automatic upon Dean's final approval"
msgstr "<strong>Pelaksana:</strong> Otomatis setelah persetujuan akhir Dekan"

#. module: campus_thesis
#: model_terms:ir.ui.view,arch_db:campus_thesis.thesis_homepage_docs
msgid "As soon as the Faculty Dean approves, the student's status automatically changes to <strong>Graduated</strong> and the system assigns them to the <strong>nearest open Graduation (Wisuda) batch</strong> that still has available seats. Students and staff can then print the official <strong>Graduation Clearance Sheet (PDF)</strong>."
msgstr "Begitu Dekan Fakultas menyetujui, status mahasiswa otomatis berubah menjadi <strong>Lulus (Graduated)</strong> dan sistem menempatkannya ke <strong>jadwal Wisuda terdekat yang masih buka</strong> dan masih memiliki kuota. Mahasiswa maupun staf kemudian dapat mencetak <strong>Lembar Bebas/Yudisium &amp; Wisuda (PDF)</strong>."

#. module: campus_thesis
#: model_terms:ir.ui.view,arch_db:campus_thesis.thesis_homepage_docs
msgid "Make sure at least one upcoming <strong>Graduation Schedule</strong> is created, marked <em>Open</em>, and has available quota before the Dean approves Yudisium."
msgstr "Pastikan minimal sudah ada satu <strong>Jadwal Wisuda</strong> mendatang yang dibuat, berstatus <em>Buka (Open)</em>, dan memiliki kuota tersedia sebelum Dekan menyetujui yudisium."

#. module: campus_thesis
msgid "Primary Supervisor %(name)s must belong to the student's study program (%(program)s)."
msgstr "Pembimbing Utama %(name)s harus berasal dari program studi mahasiswa (%(program)s)."

#. module: campus_thesis
msgid "Graduation schedule '%(name)s' is full (quota: %(quota)s)."
msgstr "Jadwal wisuda '%(name)s' sudah penuh (kuota: %(quota)s)."

#. module: campus_thesis
msgid "Participant quota cannot be lowered below active participants (%s)."
msgstr "Kuota peserta tidak dapat diturunkan di bawah jumlah peserta aktif (%s)."

#. module: campus_thesis
msgid "Snapshot, academic year, and workflow audit fields cannot be modified directly."
msgstr "Field ringkasan prodi, tahun akademik, dan tanggal alur tidak dapat diubah langsung."

#. module: campus_thesis
msgid "Only Academic Staff or Campus Administrators can assign a graduation schedule."
msgstr "Hanya Staf Akademik atau Administrator Kampus yang dapat menetapkan jadwal wisuda."

#. module: campus_thesis
msgid "Only Academic Staff or Campus Administrators can cancel a thesis."
msgstr "Hanya Staf Akademik atau Administrator Kampus yang dapat membatalkan skripsi."

#. module: campus_thesis
msgid "Only the assigned Thesis Supervisor(s) or Campus Administrator may create progress logs."
msgstr "Hanya Pembimbing Skripsi yang ditugaskan atau Administrator Kampus yang dapat membuat log bimbingan."

#. module: campus_thesis
msgid "Supervisors can only update review status and feedback, not student log entries (%s)."
msgstr "Pembimbing hanya dapat memperbarui status tinjauan dan catatan umpan balik, bukan isi log mahasiswa (%s)."
