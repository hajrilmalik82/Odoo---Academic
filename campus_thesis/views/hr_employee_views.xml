<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_inherit_thesis" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.thesis</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="campus_employees.view_employee_form_inherit_academic"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_supervised_theses" type="object"
                        class="oe_stat_button" icon="fa-book"
                        invisible="academic_role != 'lecturer'"
                        groups="campus_core.group_campus_lecturer,campus_core.group_campus_academic_staff">
                    <field name="supervised_thesis_count" widget="statinfo" string="Theses"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
