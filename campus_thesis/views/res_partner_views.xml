<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_campus_student_form_standalone_thesis" model="ir.ui.view">
        <field name="name">res.partner.form.student.standalone.thesis</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="campus_core.view_campus_student_form_standalone"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_thesis" type="object"
                        class="oe_stat_button" icon="fa-book"
                        groups="campus_core.group_campus_lecturer,campus_core.group_campus_academic_staff">
                    <field name="thesis_count" widget="statinfo" string="Theses"/>
                </button>
            </xpath>
        </field>
    </record>

    <record id="view_partner_form_inherit_campus_thesis" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.campus.thesis</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="campus_core.view_partner_form_inherit_campus"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_thesis" type="object"
                        class="oe_stat_button" icon="fa-book"
                        invisible="not is_student"
                        groups="campus_core.group_campus_lecturer,campus_core.group_campus_academic_staff">
                    <field name="thesis_count" widget="statinfo" string="Theses"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
