        <record id="mail_activity_type_yudisium_approval" model="mail.activity.type">
            <field name="name">Yudisium Approval</field>
            <field name="summary">Review and approve student Yudisium clearance</field>
            <field name="res_model">campus.thesis</field>
            <field name="category">default</field>
            <field name="delay_count">3</field>
            <field name="delay_unit">days</field>
            <field name="icon">fa-graduation-cap</field>
        </record>
    </data>
</odoo>
