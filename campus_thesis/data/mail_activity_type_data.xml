        <record id="mail_activity_type_thesis_supervisor" model="mail.activity.type">
            <field name="name">Thesis Supervision Request</field>
            <field name="summary">Approve or reject student thesis supervision request</field>
            <field name="res_model">campus.thesis</field>
            <field name="category">default</field>
            <field name="delay_count">3</field>
            <field name="delay_unit">days</field>
            <field name="icon">fa-user-plus</field>
