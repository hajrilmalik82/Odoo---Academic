<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate="1": this file sets the website up ONCE, when campus_core is
         installed. convert.py:273 and :360 skip both <function> and <record>
         in a noupdate block on every later update.

         It used to run on every campus_core upgrade, which cost two things.
         `search="[]"` rewrote configurator_done on EVERY website row, so a
         second website added later was silently reconfigured behind the
         administrator's back. And it cleared the noupdate flag on
         website.menu_home permanently — the flag that stops `-u website`
         restoring that menu from the website module's own data file, where it
         is called "Home" (addons/website/data/website_data.xml:508). With the
         flag gone, every website upgrade reverted the menu from Panduan. -->
    <data noupdate="1">

        <!-- Skip the website setup wizard.
             forcecreate="0" so that if a future Odoo renames or drops this
             xmlid, the install skips the record instead of aborting at
             convert.py:390 with "Cannot update missing record". -->
        <record id="website.website_configurator_todo" model="ir.actions.todo" forcecreate="0">
            <field name="state">done</field>
        </record>

        <!-- eval, not <value model=... search=.../>: convert.py:76-96 returns
             only ids[0] when the <value> carries no name=, so the search form
             marked just the first website done and every website added after
             that still walked into the configurator. -->
        <function model="website" name="write"
                  eval="[obj().env['website'].search([]).ids, {'configurator_done': True}]"/>

        <!-- Renamed with a plain write rather than a <record> override of
             website.menu_home. Overriding another module's xmlid is what
             forced that noupdate flag off in the first place; writing to the
             record leaves website's own protection intact, so the name now
             survives `-u website`. -->
        <function model="website.menu" name="write">
            <value model="website.menu" search="[('id', '=', ref('website.menu_home'))]"/>
            <value eval="{'name': 'Panduan'}"/>
        </function>

    </data>
</odoo>
