#. module: campus_website
#: model_terms:ir.ui.view,arch_db:campus_website.core_homepage_docs
msgid ""
"<i class=\"fa fa-list-ul text-dark me-2\"/> <strong>How to Use:</strong> "
"Open <strong>Study Plan (KRS)</strong> menu → Check one or more KRS lines to"
" process → Click <strong>\"⚙️ Actions\"</strong> button at the top of the "
"table."
msgstr ""

#. module: campus_website
#: model_terms:ir.ui.view,arch_db:campus_website.core_homepage_docs
msgid ""
"<i class=\"fa fa-lock text-dark me-2\"/> <strong>Security (Row-Level "
"Security):</strong> Advisor A <strong>cannot</strong> approve or view KRS "
"from Advisor B's students. Access rights are absolutely restricted."
msgstr ""

#. module: campus_website
#: model_terms:ir.ui.view,arch_db:campus_website.core_homepage_docs
msgid ""
"<i class=\"fa fa-magic text-dark me-2\"/> <strong>Automatic "
"Creation:</strong> Admin does not need to create KHS from scratch. Simply "
"click <strong>Lock &amp; Generate KHS</strong> on the student's KRS, and the"
" system automatically creates an exact copy in the KHS module!"
msgstr ""

#. module: campus_website
#: model_terms:ir.ui.view,arch_db:campus_website.core_homepage_docs
msgid ""
"<i class=\"fa fa-magic text-primary me-2\"/> <strong>Action (Assign "
"Schedule):</strong> Open Class form, click <strong>Students</strong> tab, "
"then click <strong>Assign Schedule (Massive)</strong>. The system will "
"search for all students taking this class but have no schedule, and you can "
"assign them to a schedule at once!"
msgstr ""

