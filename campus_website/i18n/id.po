msgid ""
"<i class=\"fa fa-bolt text-danger me-2\"/> <strong>Available Options in "
"Actions Menu:</strong>"
msgstr ""

#. module: campus_website
#: model_terms:ir.ui.view,arch_db:campus_website.core_homepage_docs
msgid ""
"<i class=\"fa fa-calculator text-success me-2\"/> <strong>Action:</strong> "
"Lecturer inputs final grade (e.g. 80). The system instantly calculates the "
"grade points and GPA (Cumulative Grade Point Average) of the student."
msgstr ""

#. module: campus_website
#: model_terms:ir.ui.view,arch_db:campus_website.core_homepage_docs
msgid "<i class=\"fa fa-calculator text-success me-2\"/>KHS Transcript Automation"
msgstr ""

#. module: campus_website
#: model_terms:ir.ui.view,arch_db:campus_website.core_homepage_docs
msgid ""
"<i class=\"fa fa-calendar text-dark me-2\"/> <strong>Scheduling "
"System:</strong> Schedule determines Day, Start Time, End Time, Room, and "
"Lecturer. You can create multiple schedules for one class (e.g., theory and "
"lab)."
msgstr ""

#. module: campus_website
#: model_terms:ir.ui.view,arch_db:campus_website.core_homepage_docs
msgid ""
"<i class=\"fa fa-calendar-check-o text-primary me-2\"/> <strong>Setup "
"Guide:</strong> Open <strong>Configuration → Academic Years</strong> menu → "
"Choose active Academic Year → Fill <strong>KRS Start Date</strong> and "
"<strong>KRS End Date</strong> fields."
msgstr ""

#. module: campus_website
#: model_terms:ir.ui.view,arch_db:campus_website.core_homepage_docs
msgid "<i class=\"fa fa-calendar-check-o text-primary me-2\"/>Dynamic Scheduling"
msgstr ""

#. module: campus_website
#: model_terms:ir.ui.view,arch_db:campus_website.core_homepage_docs
msgid ""
"<i class=\"fa fa-check-circle text-success me-2\"/> <strong>Action:</strong>"
" Advisor clicks <strong>Approve</strong>. KRS is locked and the student is "
"officially registered in the class."
msgstr ""

#. module: campus_website
#: model_terms:ir.ui.view,arch_db:campus_website.core_homepage_docs
msgid ""
"<i class=\"fa fa-check-circle text-success me-2\"/> <strong>Action:</strong>"
" Student clicks <strong>Submit</strong> to send KRS to the Academic Advisor "
"(PA)."
msgstr ""

#. module: campus_website
#: model_terms:ir.ui.view,arch_db:campus_website.core_homepage_docs
