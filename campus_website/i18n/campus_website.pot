msgid ""
"<strong>Class Quota Full:</strong> The classroom capacity is already full. "
"Choose another parallel class or ask Admin to adjust the room/quota."
msgstr ""

#. module: campus_website
#: model_terms:ir.ui.view,arch_db:campus_website.core_homepage_docs
msgid ""
"<strong>Course Packages (Mass KRS):</strong> Group mandatory subjects per "
"Study Program and Academic Year into a Package, then click <strong>Generate "
"KRS</strong>. Select the students who do not have a KRS yet to create their "
"Draft KRS in one click."
msgstr ""

#. module: campus_website
#: model_terms:ir.ui.view,arch_db:campus_website.core_homepage_docs
msgid ""
"<strong>Exceeds SKS Limit:</strong> Total SKS exceeds the maximum allowed "
"for the student's current GPA. Drop one or more subjects until within the "
"limit."
msgstr ""

#. module: campus_website
#: model_terms:ir.ui.view,arch_db:campus_website.core_homepage_docs
msgid ""
"<strong>KRS Period Closed:</strong> Students can only edit or submit KRS "
"between the <em>KRS Start Date</em> and <em>KRS End Date</em> set on the "
"active Academic Year. Outside that window, contact Academic Admin."
msgstr ""

#. module: campus_website
#: model_terms:ir.ui.view,arch_db:campus_website.core_homepage_docs
msgid ""
"<strong>Mass Schedule Assignment:</strong> Open a Class → go to the "
"<strong>Students</strong> tab → click <strong>Assign Schedule "
"(Massive)</strong> to assign a schedule to all enrolled students who do not "
"have one yet."
msgstr ""

#. module: campus_website
#: model_terms:ir.ui.view,arch_db:campus_website.core_homepage_docs
msgid ""
"<strong>Mass Status Actions:</strong> In the <strong>Study Plan "
"(KRS)</strong> list view, check the KRS rows you want to process, click "
"<strong>Actions</strong> at the top, and choose <em>Mass Submit</em>, "
"<em>Mass Approve</em>, <em>Mass Lock</em>, <em>Mass Reject</em>, or <em>Mass"
" Unlock</em>."
msgstr ""

#. module: campus_website
#: model_terms:ir.ui.view,arch_db:campus_website.core_homepage_docs
msgid ""
"<strong>Missing Prerequisite:</strong> A subject requires passing a "
"prerequisite subject in KHS first. Remove the subject until the prerequisite"
" is passed."
msgstr ""

#. module: campus_website
#: model_terms:ir.ui.view,arch_db:campus_website.core_homepage_docs
msgid ""
"<strong>No Lecturer Overlap:</strong> A lecturer cannot be assigned to two "
"classes at the same time. Pick another lecturer or adjust the schedule."
msgstr ""

#. module: campus_website
#: model_terms:ir.ui.view,arch_db:campus_website.core_homepage_docs
msgid ""
"<strong>No Room Overlap:</strong> You cannot schedule two classes in the "
"same room at the same day and overlapping time. Change the room or time slot"
" if blocked."
msgstr ""

#. module: campus_website
#: model_terms:ir.ui.view,arch_db:campus_website.core_homepage_docs
msgid ""
"<strong>Schedule Conflict:</strong> Two chosen classes overlap in day and "
"time. Replace one of them with a different schedule."
msgstr ""

