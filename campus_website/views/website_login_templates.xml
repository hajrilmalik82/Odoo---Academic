<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Optional Demo Login Panel for Portfolio / Staging (Fail-Closed by Default) -->
    <template id="campus_demo_login" inherit_id="web.login" name="Campus Demo Login">
        <xpath expr="//form[@role='form']" position="before">
            <!-- Fail-closed: only shown when an administrator explicitly enables
                 campus_website.show_demo_login = 1/true/yes in System Parameters. -->
            <t t-set="icp" t-value="request.env['ir.config_parameter'].sudo()"/>
            <t t-set="show_demo_login" t-value="(icp.get_param('campus_website.show_demo_login') or '').strip().lower() in ('1', 'true', 'yes')"/>
            <t t-if="show_demo_login">
                <t t-set="demo_email" t-value="(icp.get_param('campus_website.demo_login_email') or 'admincampus@gmail.com').strip()"/>
                <t t-set="demo_password" t-value="icp.get_param('campus_website.demo_login_password') or '123'"/>

                <!-- Desktop side panel -->
                <div class="portfolio-demo-box">
                    <div class="text-center mb-4">
                        <i class="fa fa-university fa-4x text-light mb-3" aria-hidden="true"/>
                        <h4 class="fw-bold text-white mb-0">Campus Academic</h4>
                        <p class="text-light opacity-75">SIAKAD Portfolio</p>
                    </div>

                    <h6 class="text-warning mb-3 fw-bold border-bottom border-warning pb-2">
                        <i class="fa fa-info-circle me-2" aria-hidden="true"/> Portfolio Reviewer?
                    </h6>
                    <button type="button"
                            class="btn btn-sm btn-outline-light w-100 text-start campus-demo-login-btn"
                            t-att-data-demo-login="demo_email"
                            t-att-data-demo-password="demo_password">
                        <i class="fa fa-user-secret me-2" aria-hidden="true"/> <t t-out="demo_email"/>
                    </button>

                    <div class="text-center mt-3">
                        <small class="text-light opacity-75">Password: <strong><t t-out="demo_password"/></strong></small>
                    </div>
                </div>

                <!-- Mobile minimal version -->
                <div class="d-block d-lg-none mt-3 mb-4 text-center border p-3 rounded bg-light">
                    <h6 class="text-muted fw-bold">
                        <i class="fa fa-info-circle me-1" aria-hidden="true"/> Demo Login (Pass: <t t-out="demo_password"/>)
                    </h6>

                    <button type="button"
                            class="btn btn-sm btn-outline-dark w-100 mb-2 campus-demo-login-btn"
                            t-att-data-demo-login="demo_email"
                            t-att-data-demo-password="demo_password">
                        <i class="fa fa-user-secret me-1" aria-hidden="true"/> Login as Campus Admin
                    </button>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
